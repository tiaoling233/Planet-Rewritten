*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.binlog
MSBuild_Logs/

# ---------------- 原生工具缓存 ----------------
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.[Cc]ache
!?*.[Cc]ache/

# ---------------- 分析/覆盖率/第三方工具输出 ----------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
_TeamCity*
*.dotCover
.axoCover/*
!.axoCover/settings.json
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
_NCrunch_*
.NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
FakesAssemblies/
BenchmarkDotNet.Artifacts/
artifacts/
.artifacts/
OpenCover/

# ---------------- NuGet ----------------
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
**/[Pp]ackages/*
!**/[Pp]ackages/build/
#!**/[Pp]ackages/repositories.config

# ---------------- 发布/打包输出 ----------------
publish/
*.pubxml
*.publishproj
*.azurePubxml
PublishScripts/
*.appx
*.appxbundle
*.appxupload
AppPackages/
BundleArtifacts/
*.cab
*.msi
*.msix
*.msm
*.msp
*.vsix

# ---------------- VS Code / 其他 IDE ----------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
.idea/
*.sln.iml
**/.vshistory/

# ---------------- 操作系统/通用忽略 ----------------
.DS_Store
Thumbs.db
Desktop.ini
~$*
node_modules/