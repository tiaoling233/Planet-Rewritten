<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Planet</AssemblyName>
    <RootNamespace>Planet.Launcher</RootNamespace>
    <ApplicationIcon>..\Planet.Main\Assets\planet.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <Product>Planet</Product>
    <Description>Planet 便携版启动器：负责校验目录结构并启动软件本体 Planet.Main.exe。</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AppLayout.cs" Link="Shared\AppLayout.cs" />
  </ItemGroup>

</Project>