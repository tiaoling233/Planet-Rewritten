<Application x:Class="Planet.Main.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Planet.Main"
             StartupUri="MainWindow.xaml">
        <Application.Resources>
        <ResourceDictionary>
            <!-- HandyControl 主题：SkinDefault(画刷) 在前，Theme(样式) 在后，顺序不可调换 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局主题资源：ThemeBaseBrush 用于强调，ThemeBackgroundBrush 用于主背景。 -->
            <SolidColorBrush x:Key="ThemeBaseBrush" Color="#3E6F96" />
            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#3E6F96" />
            <Color x:Key="ThemeGlowColor">#3E6F96</Color>
            <SolidColorBrush x:Key="ThemeHoverBrush" Color="#1F3E6F96" />
            <SolidColorBrush x:Key="ThemePressedBrush" Color="#383E6F96" />

            <!-- 全局圆角按钮样式：弹窗、??? 页等功能按钮统一使用 -->
            <Style x:Key="RoundedButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="Background" Value="{DynamicResource ThemeBaseBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 通用灰色悬浮滤镜：覆盖在内容上方，兼容任意主题底色。 -->
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                    <!-- 通用灰色悬浮滤镜：默认折叠，悬浮时覆盖在内容上方。 -->
                                    <Border x:Name="HoverOverlay"
                                            Background="Gray"
                                            Opacity="0.15"
                                            CornerRadius="6"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.25" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
