        <Viewbox x:Key="IconHide" Width="20" Height="20" Stretch="Uniform">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M128 448h768v128H128z" />
        </Viewbox>
        <Viewbox x:Key="IconExit" Width="20" Height="20" Stretch="Uniform">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M1022.583467 127.803733 894.779733 0 511.291733 383.4624 127.8464 0 0 127.803733 383.496533 511.274667 0 894.737067 127.8464 1022.5408 511.291733 639.0784 894.779733 1022.5408 1022.583467 894.737067 639.138133 511.274667Z" />
        </Viewbox>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧标签栏（固定 200px） ============ -->
        <Grid Grid.Column="0"
              Background="{StaticResource SidebarBrush}"
              MouseLeftButtonDown="OnSidebar_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：应用图标（SVG）+ 标题；空白区可拖拽窗口 -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="20,0"
                        VerticalAlignment="Center">
                <StaticResource ResourceKey="IconPlanet" />
                <TextBlock Text="Planet"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#9AA3AF"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </StackPanel>

            <!-- 五个导航按钮（SVG 图标 + 文本，图标颜色跟随 Foreground / hover 变色） -->
            <StackPanel Grid.Row="1">
                <RadioButton x:Name="BtnHome"
                             GroupName="NavGroup"
                             Style="{StaticResource NavRadioStyle}"
                             Tag="0" Checked="OnNavButtonChecked"
                             AutomationProperties.Name="主页">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StaticResource ResourceKey="IconHome" />
                        <TextBlock Text="主页" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnFunct"
                             GroupName="NavGroup"
                             Style="{StaticResource NavRadioStyle}"
                             Tag="1" Checked="OnNavButtonChecked"
                             AutomationProperties.Name="功能">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StaticResource ResourceKey="IconFunct" />
                        <TextBlock Text="功能" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnMystery"
                             GroupName="NavGroup"
                             Style="{StaticResource NavRadioStyle}"
                             Tag="2" Checked="OnNavButtonChecked"
                             AutomationProperties.Name="???">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StaticResource ResourceKey="IconMystery" />
                        <TextBlock Text="???" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnInfo"
                             GroupName="NavGroup"
                             Style="{StaticResource NavRadioStyle}"
                             Tag="3" Checked="OnNavButtonChecked"
                             AutomationProperties.Name="信息">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StaticResource ResourceKey="IconInfo" />
                        <TextBlock Text="信息" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <!-- 注意：ref/svgicon0.txt 未提供“设置”图标（仅 7 个），暂用 Emoji 占位，待补充 SVG 后替换 -->
                <RadioButton x:Name="BtnSettings"
                             GroupName="NavGroup"
                             Style="{StaticResource NavRadioStyle}"
                             Tag="4" Checked="OnNavButtonChecked"
                             AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="⚙️" Margin="1,0,0,0" VerticalAlignment="Center" FontSize="14" />
                        <TextBlock Text="设置" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 底部：隐藏 / 退出（SVG 图标，AutomationProperties.Name 保证可访问性与 UIA 可测） -->
            <Grid Grid.Row="3" Margin="10,0,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnHide"
                        Grid.Column="0"
                        Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Center"
                        Margin="0,3,5,0"
                        AutomationProperties.Name="隐藏"
                        Click="OnHideClick">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconHide" />
                        <TextBlock Text="隐藏" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnExit"
                        Grid.Column="1"
                        Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Center"
                        Margin="5,3,0,0"
                        AutomationProperties.Name="退出"
                        Click="OnExitClick">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconExit" />
                        <TextBlock Text="退出" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ============ 右侧主内容区（占满剩余空间） ============ -->
        <Grid Grid.Column="1" Background="{StaticResource ContentBrush}">
            <ContentControl x:Name="MainContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- 背景暗化遮罩：弹窗弹出时覆盖全部内容（Panel.ZIndex 确保在最顶层） -->
        <Border x:Name="DimOverlay"
                Grid.ColumnSpan="2"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="999" />
    </Grid>
</Window>
