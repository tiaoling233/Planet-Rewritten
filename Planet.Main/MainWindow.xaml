<Window x:Class="Planet.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Planet.Main"
        mc:Ignorable="d"
        Title="Planet"
        Icon="Assets/planet.ico"
        Height="560"
        Width="900"
        MinHeight="420"
        MinWidth="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#23272F" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#C7CDD6" />
        <SolidColorBrush x:Key="ContentBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="PageTextBrush" Color="#444A53" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Background="{StaticResource SidebarBrush}"
              MouseLeftButtonDown="OnSidebar_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Planet"
                       Margin="20,0"
                       VerticalAlignment="Center"
                       Foreground="#9AA3AF"
                       FontSize="13"
                       FontWeight="SemiBold" />

            <StackPanel Grid.Row="1">
                <RadioButton x:Name="BtnHome"
                             GroupName="NavGroup"
                             IsChecked="True"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Tag="0" Click="OnNavButtonClick"
                             AutomationProperties.Name="主页">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconHome" />
                        <TextBlock Text="主页" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnFunct"
                             GroupName="NavGroup"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Tag="1" Click="OnNavButtonClick"
                             AutomationProperties.Name="功能">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconFunction" />
                        <TextBlock Text="功能" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnMystery"
                             GroupName="NavGroup"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Tag="2" Click="OnNavButtonClick"
                             AutomationProperties.Name="???">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconMystery" />
                        <TextBlock Text="???" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnInfo"
                             GroupName="NavGroup"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Tag="3" Click="OnNavButtonClick"
                             AutomationProperties.Name="信息">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconInfo" />
                        <TextBlock Text="信息" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BtnSettings"
                             GroupName="NavGroup"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Tag="4" Click="OnNavButtonClick"
                             AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" Margin="1,0,0,0" VerticalAlignment="Center" FontSize="14" />
                        <TextBlock Text="设置" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Grid Grid.Row="3" Margin="10,0,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnHide"
                        Grid.Column="0"
                        HorizontalContentAlignment="Center"
                        Margin="0,3,5,0"
                        AutomationProperties.Name="隐藏"
                        Click="OnHideClick">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconHide" />
                        <TextBlock Text="隐藏" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnExit"
                        Grid.Column="1"
                        HorizontalContentAlignment="Center"
                        Margin="5,3,0,0"
                        AutomationProperties.Name="退出"
                        Click="OnExitClick">
                    <StackPanel Orientation="Horizontal">
                        <StaticResource ResourceKey="IconExit" />
                        <TextBlock Text="退出" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource ContentBrush}">
            <ContentControl x:Name="MainContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <Border x:Name="DimOverlay"
                Grid.ColumnSpan="2"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="999" />
    </Grid>
</Window>