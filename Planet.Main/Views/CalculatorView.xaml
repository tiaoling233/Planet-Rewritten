<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500">

    <UserControl.Resources>
        <!-- 继承 HandyControl 全局隐式 Button 样式，仅统一计算器按键尺寸和间距。 -->
        <Style x:Key="CalculatorKeyStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <!-- 页面整体卡片：白底、圆角、浅灰描边。 -->
    <Border Background="White"
            BorderBrush="#E3E6EA"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Padding="18,14"
            MinWidth="520"
            MaxWidth="520"
            HorizontalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.20"
                              Color="#000000" />
        </Border.Effect>

        <Grid x:Name="CalculatorContent" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题与显示区域 -->
            <TextBlock Grid.Row="0"
                       Text="计算器"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36" />

            <TextBox x:Name="DisplayBox"
                     Grid.Row="1"
                     Height="72"
                     Margin="0,10,0,0"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     FontSize="24"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Background="#F8F9FB"
                     AutomationProperties.Name="显示框" />

            <TextBlock x:Name="HistoryText"
                       Grid.Row="2"
                       Height="20"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="#9AA0A8"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />

            <!-- 科学计算扩展区：默认收起，不挤占基础四列键盘。 -->
            <Expander Grid.Row="3"
                      Margin="0,10,0,2"
                      Header="科学计算"
                      IsExpanded="False">
                <UniformGrid Columns="3"
                             Width="{Binding ActualWidth, ElementName=CalculatorContent}"
                             Margin="0,8,0,0">
                    <Button Content="(" Tag="(" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                    <Button Content=")" Tag=")" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                    <Button Content="√" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="平方根" Click="OnSquareRootClick" />

                    <Button Content="x²" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="平方" Click="OnSquareClick" />
                    <Button Content="1/x" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="倒数" Click="OnReciprocalClick" />
                    <Button Content="π" Tag="π" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                </UniformGrid>
            </Expander>

            <!-- 基础键盘：UniformGrid 严格平铺 4 列 × 5 行。 -->
            <UniformGrid x:Name="Keypad"
                         Grid.Row="4"
                         Columns="4"
                         Rows="5"
                         Width="{Binding ActualWidth, ElementName=CalculatorContent}"
                         Margin="0,8,0,0">

                <!-- 功能行：%、C、⌫、/ -->
                <Button Content="%" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="百分号" Click="OnPercentClick" />
                <Button Content="C" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="清空" Click="OnClearClick" />
                <Button Content="⌫" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="退格" Click="OnBackspaceClick" />
                <Button Content="/" Tag="/" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />

                <!-- 数字行 1：7、8、9、* -->
                <Button Content="7" Tag="7" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="8" Tag="8" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="9" Tag="9" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="*" Tag="*" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />

                <!-- 数字行 2：4、5、6、- -->
                <Button Content="4" Tag="4" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="5" Tag="5" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="6" Tag="6" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="-" Tag="-" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />

                <!-- 数字行 3：1、2、3、+ -->
                <Button Content="1" Tag="1" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="2" Tag="2" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="3" Tag="3" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="+" Tag="+" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />

                <!-- 底行：±、0、.、= -->
                <Button Content="±" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="正负号" Click="OnToggleSignClick" />
                <Button Content="0" Tag="0" Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="." Tag="." Style="{StaticResource CalculatorKeyStyle}" Click="OnKeyClick" />
                <Button Content="=" Style="{StaticResource CalculatorKeyStyle}" AutomationProperties.Name="等于" Click="OnEqualsClick" />
            </UniformGrid>

            <!-- 提示 / 状态行（除零、非法表达式等错误也在此提示） -->
            <TextBlock Grid.Row="5"
                       x:Name="HintText"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="#9AA0A8"
                       TextWrapping="Wrap"
                       Text="提示：支持 + - * /、括号、%、±、1/x、√、x²、π；C 清空，⌫ 删除末位，= 求值。" />
        </Grid>
    </Border>
</UserControl>