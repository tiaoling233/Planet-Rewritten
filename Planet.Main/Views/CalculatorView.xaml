<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="400">

    <!-- 页面整体卡片：白底、圆角、浅灰描边（与摩斯密码/主页/设置页风格一致） -->
    <Border Background="White"
            BorderBrush="#E3E6EA"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.20"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <TextBlock Grid.Row="0"
                       Text="计算器"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36" />

            <!-- 表达式 / 结果显示（只读，右对齐） -->
            <TextBox x:Name="DisplayBox"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     MinHeight="52"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     FontSize="24"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Background="#F8F9FB"
                     AutomationProperties.Name="显示框" />

            <!-- 按键网格：4 列 × 5 行，UniformGrid 保证等宽等高对齐 -->
            <UniformGrid x:Name="Keypad"
                         Grid.Row="2"
                         Margin="0,14,0,0"
                         Columns="4"
                         Rows="5">

                <!-- 第 1 行：清空 / 退格 / 左右括号 -->
                <Button Content="C" Height="44" Margin="4"
                        AutomationProperties.Name="清空"
                        Click="OnClearClick" />
                <Button Content="⌫" Height="44" Margin="4"
                        AutomationProperties.Name="退格"
                        Click="OnBackspaceClick" />
                <Button Content="(" Height="44" Margin="4" Tag="(" Click="OnKeyClick" />
                <Button Content=")" Height="44" Margin="4" Tag=")" Click="OnKeyClick" />

                <!-- 第 2 行 -->
                <Button Content="7" Height="44" Margin="4" Tag="7" Click="OnKeyClick" />
                <Button Content="8" Height="44" Margin="4" Tag="8" Click="OnKeyClick" />
                <Button Content="9" Height="44" Margin="4" Tag="9" Click="OnKeyClick" />
                <Button Content="/" Height="44" Margin="4" Tag="/" Click="OnKeyClick" />

                <!-- 第 3 行 -->
                <Button Content="4" Height="44" Margin="4" Tag="4" Click="OnKeyClick" />
                <Button Content="5" Height="44" Margin="4" Tag="5" Click="OnKeyClick" />
                <Button Content="6" Height="44" Margin="4" Tag="6" Click="OnKeyClick" />
                <Button Content="*" Height="44" Margin="4" Tag="*" Click="OnKeyClick" />

                <!-- 第 4 行 -->
                <Button Content="1" Height="44" Margin="4" Tag="1" Click="OnKeyClick" />
                <Button Content="2" Height="44" Margin="4" Tag="2" Click="OnKeyClick" />
                <Button Content="3" Height="44" Margin="4" Tag="3" Click="OnKeyClick" />
                <Button Content="-" Height="44" Margin="4" Tag="-" Click="OnKeyClick" />

                <!-- 第 5 行 -->
                <Button Content="0" Height="44" Margin="4" Tag="0" Click="OnKeyClick" />
                <Button Content="." Height="44" Margin="4" Tag="." Click="OnKeyClick" />
                <Button Content="=" Height="44" Margin="4"
                        AutomationProperties.Name="等于"
                        Click="OnEqualsClick" />
                <Button Content="+" Height="44" Margin="4" Tag="+" Click="OnKeyClick" />
            </UniformGrid>

            <!-- 提示 / 状态行（除零、非法表达式等错误也在此提示） -->
            <TextBlock Grid.Row="3"
                       x:Name="HintText"
                       FontSize="12"
                       Foreground="#9AA0A8"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="提示：支持 + - * / 与括号；C 清空，⌫ 删除末位，= 求值。" />
        </Grid>
    </Border>
</UserControl>