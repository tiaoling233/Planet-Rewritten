<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Planet.Main.Views.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Planet.Main.Views"
        mc:Ignorable="d"
        Title="计算器"
        Width="420"
        Height="580"
        MinWidth="380"
        MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DesignHeight="580"
        d:DesignWidth="420">

    <!-- 独立窗口：透明外框（留出卡片阴影空间），内容为 CalculatorView；
         右上角悬浮关闭按钮，空白区域可拖动窗口。 -->
    <Grid Margin="18" MouseLeftButtonDown="OnChromeMouseLeftButtonDown">
        <views:CalculatorView />

        <Button x:Name="CloseButton"
                Content="✕"
                Width="30" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,14,0"
                AutomationProperties.Name="关闭"
                Click="OnCloseClick" />
    </Grid>
</Window>