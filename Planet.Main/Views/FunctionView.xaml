<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.FunctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <UserControl.Resources>
        <!-- 功能卡片样式：白底圆角 + 浅灰描边；悬浮时轻微上浮 + 主题基础色光晕。
             整卡可点击（Button），模板已消除默认边框/内边距。 -->
        <Style x:Key="FunctionCardStyle" TargetType="Button">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="130" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E3E6EA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3E6F96" />
                                <!-- 轻微上浮：直接替换 Border 的 RenderTransform（模板内命名的 Freezable 不能作为触发器目标） -->
                                <Setter TargetName="CardBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="0" Y="-3" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3E6F96"
                                                          BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 功能页：默认显示卡片网格；点击已实现功能后在同一内容区显示子视图。 -->
    <Grid>
        <ScrollViewer x:Name="GridView"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,24">

            <TextBlock Text="功能"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36"
                       HorizontalAlignment="Center" />

            <TextBlock Text="选择一个功能开始使用（插件卡片始终排在最前）"
                       FontSize="13"
                       Foreground="#9AA0A8"
                       Margin="0,8,0,20"
                       HorizontalAlignment="Center" />

            <ItemsControl x:Name="CardItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 整卡可点击；CommandParameter 传递卡片数据，统一由 OnCardClick 处理 -->
                        <Button Style="{StaticResource FunctionCardStyle}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}"
                                Click="OnCardClick">
                            <StackPanel>
                                <Viewbox Width="30"
                                         Height="30"
                                         HorizontalAlignment="Center">
                                    <Path Data="{Binding IconData}"
                                          Fill="#3E6F96"
                                          Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2B2F36"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#9AA0A8"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </ScrollViewer>

        <!-- 已实现功能以内联视图显示；默认隐藏，点击功能卡片后切换为可见。 -->
        <ContentControl x:Name="FunctionHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="Collapsed" />
    </Grid>
</UserControl>
