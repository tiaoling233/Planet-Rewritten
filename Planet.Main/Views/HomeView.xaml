<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <!-- 主页：问候语 + 用户名 / 日期 / 时间 / 软件介绍 -->
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40">

            <TextBlock x:Name="GreetingText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="DateText"
                       FontSize="15"
                       Foreground="#6B7280"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="ClockText"
                       FontSize="52"
                       FontWeight="Bold"
                       Foreground="#3E6F96"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="IntroText"
                       FontSize="13"
                       Foreground="#9AA0A8"
                       Margin="0,22,0,0"
                       Text="Planet 重写版，欢迎体验 —— 基于 C# / .NET 8 / WPF 的桌面效率工具"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>