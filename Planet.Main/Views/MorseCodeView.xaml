<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.MorseCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="440"
             d:DesignWidth="780">

    <!-- 页面整体卡片：白底、圆角、浅灰描边（与主页/设置页风格一致） -->
    <Border Background="White"
            BorderBrush="#E3E6EA"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.20"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <TextBlock Grid.Row="0"
                       Text="摩斯密码编解码"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36" />

            <!-- 左：输入 | 中：按钮 | 右：结果 -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：原文 / 电码输入（多行，HC 隐式样式） -->
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         MinHeight="200"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <!-- 中间：编码 / 解码 -->
                <StackPanel Grid.Column="1"
                            Margin="14,0"
                            VerticalAlignment="Center">
                    <Button Content="编码"
                            Width="88" Height="34"
                            Click="OnEncodeClick" />
                    <Button Content="解码"
                            Width="88" Height="34"
                            Margin="0,10,0,0"
                            Click="OnDecodeClick" />
                </StackPanel>

                <!-- 右侧：结果（只读多行） -->
                <TextBox x:Name="ResultBox"
                         Grid.Column="2"
                         MinHeight="200"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Background="#F8F9FB" />
            </Grid>

            <!-- 提示 / 状态行 -->
            <TextBlock Grid.Row="2"
                       x:Name="HintText"
                       FontSize="12"
                       Foreground="#9AA0A8"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="提示：字母间以空格分隔，单词间以 / 分隔；大小写不敏感，支持字母、数字与常用标点。" />
        </Grid>
    </Border>
</UserControl>
