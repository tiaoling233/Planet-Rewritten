<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Planet.Main.Views.PlanetPopupWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Planet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        d:DesignHeight="220"
        d:DesignWidth="420">

    <!-- 预设弹窗：圆角 + 阴影，四行布局（标题 / 分割线 / 内容 / 按钮）。
         所有颜色均绑定到依赖属性，由调用方灵活设置。 -->
    <Border CornerRadius="14"
            Background="{Binding PopupBackground, ElementName=Root}"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Padding="24,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.28"
                              Color="#000000" />
        </Border.Effect>

        <Grid Width="380">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0：标题（左侧） -->
            <TextBlock Grid.Row="0"
                       Text="{Binding TitleText, ElementName=Root}"
                       Foreground="{Binding TitleForeground, ElementName=Root}"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Stretch"
                       TextTrimming="CharacterEllipsis" />

            <!-- Row 1：分割线 -->
            <Rectangle Grid.Row="1"
                       Height="1"
                       Fill="{Binding DividerBrush, ElementName=Root}"
                       Margin="0,12,0,14" />

            <!-- Row 2：内容（居中，自动换行） -->
            <TextBlock Grid.Row="2"
                       Text="{Binding MessageText, ElementName=Root}"
                       FontSize="14"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,4,0,18" />

            <!-- Row 3：按钮（右下角，横向排列，由 ButtonTexts 动态生成） -->
            <StackPanel Grid.Row="3"
                        x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>