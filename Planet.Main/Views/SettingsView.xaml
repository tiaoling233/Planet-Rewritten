<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">

    <UserControl.Resources>
        <!-- 设置页卡片样式 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- 设置页卡片标题 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2F36" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 设置项小标题 -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#5A6270" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 检查更新按钮 -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3E6F96" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#356082" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C4F6D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640"
                    Margin="32,24,32,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="设置"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36"
                       HorizontalAlignment="Center" />

            <!-- ============ 卡片一：主题设置 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="主题设置" Style="{StaticResource CardTitleStyle}" />

                    <!-- WrapPanel：主题名一行放不下自动换行 -->
                    <WrapPanel x:Name="ThemeWrapPanel">
                        <RadioButton Content="默认"   GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="True" Click="OnThemeButtonClick" />
                        <RadioButton Content="玄素黑" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="神秘紫" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="深海蓝" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="森林绿" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="夕阳橙" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="樱花粉" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                        <RadioButton Content="星空银" GroupName="ThemeGroup" Style="{StaticResource {x:Type ToggleButton}}" Click="OnThemeButtonClick" />
                    </WrapPanel>

                    <TextBlock x:Name="CurrentThemeText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <!-- ============ 卡片二：下载源设置 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="下载源设置" Style="{StaticResource CardTitleStyle}" />

                    <!-- 第一行：下载源下拉框 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="下载源" Style="{StaticResource SettingLabelStyle}" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1"
                                  x:Name="DownloadSourceCombo"
                                  Height="36"
                                  SelectionChanged="OnDownloadSourceChanged">
                            <ComboBoxItem Content="Gitee"  IsSelected="True" />
                            <ComboBoxItem Content="Github" />
                        </ComboBox>
                    </Grid>

                    <!-- 第二行：加速网站输入框 + 检查更新按钮 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="加速网站" Style="{StaticResource SettingLabelStyle}" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="ProxyTextBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 TextChanged="OnProxyTextChanged" />
                        <Button Grid.Column="2"
                                Content="检查更新"
                                Style="{StaticResource SettingsButtonStyle}"
                                Margin="12,0,0,0"
                                Click="OnCheckUpdateClick" />
                    </Grid>

                    <TextBlock x:Name="SettingsHintText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 卡片三：标签页选择器视效 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="标签页选择器视效" Style="{StaticResource CardTitleStyle}" />

                    <!-- 显示模式 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="显示模式" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="DisplayModeCombo"
                                  Height="36"
                                  SelectionChanged="OnDisplayModeChanged">
                            <ComboBoxItem Content="合并" IsSelected="True" />
                            <ComboBoxItem Content="独立" />
                        </ComboBox>
                    </Grid>

                    <!-- 位置 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="PositionCombo"
                                  Height="36"
                                  SelectionChanged="OnPositionChanged">
                            <ComboBoxItem Content="左" IsSelected="True" />
                            <ComboBoxItem Content="上" />
                            <ComboBoxItem Content="下" />
                            <ComboBoxItem Content="右" />
                        </ComboBox>
                    </Grid>

                    <!-- 自动隐藏模式 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自动隐藏模式" Style="{StaticResource SettingLabelStyle}" />
                        <CheckBox Grid.Column="1"
                                  x:Name="AutoHideCheck"
                                  Content="开启"
                                  FontSize="13"
                                  Foreground="#444A53"
                                  VerticalAlignment="Center"
                                  Checked="OnAutoHideToggled"
                                  Unchecked="OnAutoHideToggled" />
                    </Grid>

                    <TextBlock x:Name="VisualHintText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
