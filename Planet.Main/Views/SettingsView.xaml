<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Planet.Main.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">

    <UserControl.Resources>
        <!-- 设置页卡片样式（与 InfoView 一致：圆角 12、白底、浅灰描边） -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- 设置页卡片标题 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2F36" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 设置项小标题 -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#5A6270" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 主题按钮：圆角 8，悬浮浅灰，选中高亮 -->
        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#444A53" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F6F8FA" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EEF1F4" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bg" Property="Background" Value="#3E6F96" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#356082" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 检查更新按钮：蓝色圆角，高度 36 与输入框对齐 -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3E6F96" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#356082" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C4F6D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化文本框：白底、浅灰边框、圆角 8 -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="false" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#3E6F96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化下拉框：白底、浅灰边框、圆角 8、现代箭头 -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,32,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <ToggleButton Grid.Column="1"
                                                  x:Name="DropDownToggle"
                                                  Focusable="false"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Width="20" Height="20">
                                        <Path x:Name="Arrow"
                                              Width="10" Height="6"
                                              Stretch="Uniform"
                                              Fill="#6B7280"
                                              Data="M 0,0 L 5,5 L 10,0 Z"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MaxHeight="200"
                                        Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#3E6F96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 设置页：三个卡片（主题 / 下载源 / 标签页选择器视效） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640"
                    Margin="32,24,32,24"
                    HorizontalAlignment="Center">

            <TextBlock Text="设置"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#2B2F36"
                       HorizontalAlignment="Center" />

            <!-- ============ 卡片一：主题设置 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="主题设置" Style="{StaticResource CardTitleStyle}" />

                    <!-- WrapPanel：主题名一行放不下自动换行 -->
                    <WrapPanel x:Name="ThemeWrapPanel">
                        <Button Content="默认"   Style="{StaticResource ThemeButtonStyle}" Tag="Selected" Click="OnThemeButtonClick" />
                        <Button Content="玄素黑" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="神秘紫" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="深海蓝" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="森林绿" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="夕阳橙" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="樱花粉" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                        <Button Content="星空银" Style="{StaticResource ThemeButtonStyle}" Click="OnThemeButtonClick" />
                    </WrapPanel>

                    <!-- 当前选中的主题（仅显示，不实际切换） -->
                    <TextBlock x:Name="CurrentThemeText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 卡片二：下载源设置 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="下载源设置" Style="{StaticResource CardTitleStyle}" />

                    <!-- 第一行：下载源下拉框 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="下载源" Style="{StaticResource SettingLabelStyle}" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1"
                                  x:Name="DownloadSourceCombo"
                                  Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectionChanged="OnDownloadSourceChanged">
                            <ComboBoxItem Content="Gitee"  IsSelected="True" />
                            <ComboBoxItem Content="Github" />
                        </ComboBox>
                    </Grid>

                    <!-- 第二行：加速网站输入框 + 检查更新按钮 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="加速网站" Style="{StaticResource SettingLabelStyle}" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1"
                                 x:Name="ProxyTextBox"
                                 Style="{StaticResource SettingsTextBoxStyle}"
                                 TextChanged="OnProxyTextChanged" />
                        <Button Grid.Column="2"
                                Content="检查更新"
                                Style="{StaticResource SettingsButtonStyle}"
                                Margin="12,0,0,0"
                                Click="OnCheckUpdateClick" />
                    </Grid>

                    <TextBlock x:Name="SettingsHintText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 卡片三：标签页选择器视效 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="标签页选择器视效" Style="{StaticResource CardTitleStyle}" />

                    <!-- 显示模式 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="显示模式" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="DisplayModeCombo"
                                  Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectionChanged="OnDisplayModeChanged">
                            <ComboBoxItem Content="合并" IsSelected="True" />
                            <ComboBoxItem Content="独立" />
                        </ComboBox>
                    </Grid>

                    <!-- 位置 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="PositionCombo"
                                  Style="{StaticResource SettingsComboBoxStyle}"
                                  SelectionChanged="OnPositionChanged">
                            <ComboBoxItem Content="左" IsSelected="True" />
                            <ComboBoxItem Content="上" />
                            <ComboBoxItem Content="下" />
                            <ComboBoxItem Content="右" />
                        </ComboBox>
                    </Grid>

                    <!-- 自动隐藏模式 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自动隐藏模式" Style="{StaticResource SettingLabelStyle}" />
                        <CheckBox Grid.Column="1"
                                  x:Name="AutoHideCheck"
                                  Content="开启"
                                  FontSize="13"
                                  Foreground="#444A53"
                                  VerticalAlignment="Center"
                                  Checked="OnAutoHideToggled"
                                  Unchecked="OnAutoHideToggled" />
                    </Grid>

                    <TextBlock x:Name="VisualHintText"
                               FontSize="12"
                               Foreground="#9AA0A8"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
