<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Planet.Main.Views.ToastWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Planet Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        d:DesignHeight="60"
        d:DesignWidth="320">

    <!-- 条形信息提醒：无圆角（todo 明确要求），左侧 4px 色条 + 类型着色背景；
         MaxWidth 限制宽度，文本换行时窗口高度自适应增长 -->
    <Border x:Name="RootBorder"
            Background="{Binding ToastBackground, ElementName=Root}"
            BorderBrush="{Binding AccentBrush, ElementName=Root}"
            BorderThickness="4,0,0,0"
            Padding="14,10"
            MaxWidth="360"
            SnapsToDevicePixels="True">
        <TextBlock Text="{Binding MessageText, ElementName=Root}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="19"
                   Foreground="{Binding TextBrush, ElementName=Root}" />
    </Border>
</Window>
